SubDir HAIKU_TOP src add-ons kernel drivers disk virtual encrypted_home ;

include [ FDirName $(HAIKU_TOP) build jam encrypted_home_features.jam ] ;

if $(HAIKU_PACKAGING_ARCH) in $(ENCRYPTED_HOME_SUPPORTED_ARCHS) {
	UseHeaders [ FDirName $(HAIKU_TOP) headers private encrypted_home ] : true ;
	UseHeaders [ FDirName $(HAIKU_TOP) src libs openbsd_softraid_crypto ] : true ;
	UsePrivateKernelHeaders ;

	KernelAddon encrypted_home :
		kernel_interface.cpp
		ControlDevice.cpp
		EncryptedDevice.cpp
		:
		libopenbsd_softraid_crypto_kernel.a
	;

	Depends encrypted_home : kernel_probe ;

	ObjectC++Flags [ FGristFiles kernel_interface.o ControlDevice.o
			EncryptedDevice.o ] :
		-std=c++23
		-Werror -Wall -Wextra -Wpedantic -Wshadow -Wconversion
		-Wcast-align -Wformat=2 -Wnull-dereference -Wdouble-promotion
		-Wold-style-cast -Wnon-virtual-dtor
		-Wno-pedantic -Wno-shadow -Wno-old-style-cast
		-fno-exceptions
		-fno-rtti
		;
}
