SubDir HAIKU_TOP src libs encrypted_home ;

include [ FDirName $(HAIKU_TOP) build jam encrypted_home_features.jam ] ;

if $(HAIKU_PACKAGING_ARCH) in $(ENCRYPTED_HOME_SUPPORTED_ARCHS)
		&& [ FIsBuildFeatureEnabled openssl ] {
	UseHeaders [ FDirName $(HAIKU_TOP) headers private encrypted_home ] : true ;
	UseHeaders [ FDirName $(HAIKU_TOP) src libs phc_argon2 ] : true ;
	UseBuildFeatureHeaders openssl ;

	StaticLibrary [ MultiArchDefaultGristFiles libencrypted_home_userland.a ] :
		encrypted_volume_header.cpp
	;

	Depends [ MultiArchDefaultGristFiles libencrypted_home_userland.a ] :
		std_probe
		libphc_argon2.a
	;

	ObjectC++Flags
		[ FGristFiles encrypted_volume_header.o ]
		:
		-std=c++23
		-Werror -Wall -Wextra -Wpedantic -Wshadow -Wconversion
		-Wcast-align -Wformat=2 -Wnull-dereference -Wdouble-promotion
		-Wold-style-cast -Wnon-virtual-dtor -Wno-pedantic
	;

	Includes [ FGristFiles encrypted_volume_header.cpp ] :
		[ BuildFeatureAttribute openssl : headers ] ;
}
